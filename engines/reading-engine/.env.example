# ===== Application =====
NODE_ENV=development
APP_VERSION=4.0.0
PORT=4000
HOST=0.0.0.0

# ===== Database =====
DATABASE_URL=postgresql://buytuk:password@localhost:5432/buytuk
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# ===== Redis =====
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=buytuk:

# ===== JWT =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ===== Audio Encryption =====
AUDIO_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ===== AWS S3 (real AWS) =====
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_SESSION_TOKEN=
S3_BUCKET=buytuk-audio
S3_PRESIGNED_EXPIRES=3600

# ===== Local / MinIO / S3-compatible fallback =====
# If you set S3_ENDPOINT_URL for local testing and omit a complete AWS
# credential pair, the runtime automatically falls back to local test creds.
S3_ENDPOINT_URL=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ===== Backward-compatible aliases (optional legacy names) =====
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# AWS_ENDPOINT_URL_S3=

# ===== Inference Gateway =====
INFERENCE_GATEWAY_URL=localhost:50050
INFERENCE_API_KEY=your-inference-api-key

# ===== LLM (for AI Feedback) =====
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# ===== Observability =====
LOG_LEVEL=info
OTEL_ENDPOINT=http://localhost:4318/v1/traces
PROMETHEUS_ENABLED=true

# ===== Security =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000

# ===== Models =====
WHISPER_MODEL=large-v3-turbo
WAV2VEC2_MODEL=jonatasgrosman/wav2vec2-large-xlsr-53-arabic
MMS_MODEL=facebook/mms-1b-all

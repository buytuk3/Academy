{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "../../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths":{
      "@buytuk/contracts": ["../../packages/contracts/src/index.ts"],
      "@workspace/db": ["../../packages/database/src/index.ts"],
      "@workspace/events": ["../../packages/events/src/index.ts"],
      "@workspace/config": ["../../packages/config/src/index.ts"],
      "@workspace/observability": ["../../packages/observability/src/index.ts"],
      "@workspace/security": ["../../packages/security/src/index.ts"],
      "@workspace/queue": ["../../packages/queue/src/index.ts"],
      "@/*": ["src/*"],
      "@config/*": ["config/*"],
      "@pipeline/*": ["src/pipeline/*"],
      "@engines/*": ["src/engines/*"],
      "@queue/*": ["src/queue/*"],
      "@middleware/*": ["src/middleware/*"],
      "@security/*": ["src/security/*"],
      "@observability/*": ["src/observability/*"],
      "@realtime/*": ["src/realtime/*"],
      "@exercises/*": ["src/exercises/*"],
      "@report/*": ["src/report/*"],
      "@types/*": ["src/types/*"]
    }
  },
  "include": ["src/**/*", "config/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}

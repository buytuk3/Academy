{
  "name": "buytuk-reading-engine",
  "version": "4.0.0",
  "description": "Enterprise Arabic Reading Assessment Engine",
  "type": "module",
  "main": "./dist/src/service/reading-service.js",
  "scripts": {
    "dev": "tsx src/service/reading-service.ts",
    "build": "tsc",
    "start": "echo 'Engine is a library — run via apps/api or apps/worker (no HTTP bootstrap)'",
    "typecheck": "tsc --noEmit",
    "worker": "tsx pnpm --filter buytuk-worker start",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "worker:start": "node dist/src/queue/workers/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "drizzle-orm": "^0.31.0",
    "postgres": "^3.4.4",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "zod": "^3.23.8",
    "bullmq": "^5.7.0",
    "ioredis": "^5.4.1",
    "inversify": "^6.0.2",
    "reflect-metadata": "^0.2.2",
    "pino": "^9.1.0",
    "pino-http": "^9.0.0",
    "prom-client": "^15.1.2",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/sdk-node": "^0.51.0",
    "@opentelemetry/auto-instrumentations-node": "^0.46.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.51.0",
    "essentia.js": "^0.1.3",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.2.0",
    "uuid": "^9.0.1",
    "aws-sdk": "^2.1618.0",
    "@grpc/grpc-js": "^1.10.8",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.4.5",
    "tsx": "^4.11.0",
    "drizzle-kit": "^0.22.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.3.0",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}

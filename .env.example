# ===== Application =====
NODE_ENV=development
APP_VERSION=BuyTuk.V.01.7
PORT=4100
HOST=0.0.0.0
LOG_LEVEL=info

# ===== Database =====
DATABASE_URL=postgres://buytuk:password@127.0.0.1:5432/buytuk
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_SSL=false

# ===== Redis =====
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=buytuk

# ===== JWT / security =====
JWT_SECRET=change-me-before-production
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=buytuk
JWT_AUDIENCE=buytuk-client
AUDIO_KEK=change-me-before-production
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
PASSWORD_RESET_TTL_MINUTES=30

# ===== Inference =====
INFERENCE_GATEWAY_URL=http://127.0.0.1:8080
INFERENCE_API_KEY=
DFN_WORKER_PATH=./dfn-worker

# ===== AWS S3 (real AWS) =====
# Required for real AWS verification / production S3.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=buytuk-audio
S3_PRESIGNED_EXPIRES=3600

# ===== Local / MinIO / S3-compatible fallback =====
# Optional for local testing only. When a custom endpoint is configured and
# the AWS credential pair is missing or invalid, the runtime falls back to
# local test credentials instead of failing the presign/audio path.
S3_ENDPOINT_URL=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ===== Backward-compatible aliases (optional legacy names) =====
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# AWS_ENDPOINT_URL_S3=

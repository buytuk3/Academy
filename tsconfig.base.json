{
  "compilerOptions": {
    "incremental": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": false,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "skipLibCheck": true,
    "target": "es2022",
    "types": [],
    "customConditions": ["workspace"],
    "baseUrl": ".",
    "paths": {
      "@buytuk/contracts": ["packages/contracts/src/index.ts"],
      "@workspace/config": ["packages/config/src/index.ts"],
      "@workspace/observability": ["packages/observability/src/index.ts"],
      "@workspace/security": ["packages/security/src/index.ts"],
      "@workspace/queue": ["packages/queue/src/index.ts"],
      "@workspace/db": ["packages/database/src/index.ts"],
      "@workspace/events": ["packages/events/src/index.ts"],
      "@workspace/decisions": ["packages/decisions/src/index.ts"],
      "@workspace/curriculum": ["packages/curriculum/src/index.ts"],
      "@workspace/intelligence": ["packages/intelligence/src/index.ts"],
      "@workspace/learning-loop": ["packages/learning-loop/src/index.ts"],
      "@workspace/api-zod": ["lib/api-zod/src/index.ts"],
      "@reading-engine/*": ["engines/reading-engine/src/*"],
      "@dictation-engine/*": ["engines/dictation-engine/src/*"],
      "@numeracy-engine": ["engines/numeracy-engine/src/index.ts"],
      "@assessment-engine": ["engines/assessment-engine/src/index.ts"]
    }
  }
}
